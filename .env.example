# ──────────────────────────────────────────────────────────────────────
# AgriLink Logistics Platform — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local
# ──────────────────────────────────────────────────────────────────────

# —— App ——
APP_URL=http://localhost:3000
NODE_ENV=development

# ── MCP Servers ────────────────────────────────────────────────────────────────

# GitHub MCP — github.com > Settings > Developer settings > Personal access tokens
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Jira MCP — id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL="https://yourorg.atlassian.net"
JIRA_EMAIL="you@example.com"
JIRA_API_TOKEN=""

# Supabase MCP — supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""

# —— Supabase (get from Supabase dashboard → Settings → API) ——
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key   # Edge Functions only, never expose to browser
SUPABASE_PROJECT_ID=your_project_ref
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# —— Supabase Staging ——
SUPABASE_STAGING_URL=https://YOUR_STAGING_REF.supabase.co
SUPABASE_STAGING_PROJECT_ID=your_staging_project_ref

# —— Paystack (get from dashboard.paystack.com) ——
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# —— SMS — Termii (get from termii.com) ——
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=AgriLink
TERMII_BASE_URL=https://api.ng.termii.com

# —— Push Notifications — Expo ——
EXPO_ACCESS_TOKEN=your_expo_access_token

# —— AgriLink Integration API key (for verifying inbound requests) ——
# Generate with: openssl rand -hex 32
AGRILINK_API_KEY=your_agrilink_api_key
WEBHOOK_SIGNING_SECRET=your_hmac_webhook_signing_secret

# —— Google AI ——
GEMINI_API_KEY=your_gemini_api_key

# —— Grafana Cloud Observability (grafana.com → My Account → Stack) ——
# Sign up at: https://grafana.com/auth/sign-up/create-user?pg=hp
GRAFANA_CLOUD_URL=https://your-stack.grafana.net
GRAFANA_CLOUD_API_KEY=your_grafana_service_account_token   # Editor role required

# Prometheus remote_write (from your Grafana Cloud stack)
PROMETHEUS_PUSHGATEWAY_URL=https://prometheus-prod-01-eu-west-0.grafana.net
PROMETHEUS_PUSHGATEWAY_USER=your_prometheus_user_id
# (re-use GRAFANA_CLOUD_API_KEY as password)

# Loki (log drain — set in Supabase dashboard → Settings → Log Drains)
LOKI_URL=https://logs-prod-eu-west-0.grafana.net
GRAFANA_CLOUD_LOKI_USER=your_loki_user_id
GRAFANA_CLOUD_PROMETHEUS_USER=your_prometheus_user_id

# Prometheus remote_read URL (for datasource provisioning)
PROMETHEUS_REMOTE_READ_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom

# Termii ops phone (for alert SMS)
TERMII_OPS_PHONE=+2348000000000

# —— CI / Deployment ——
# GitHub Secrets needed for deploy.yml:
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_ID
# Grafana secrets: GRAFANA_CLOUD_URL, GRAFANA_CLOUD_API_KEY
