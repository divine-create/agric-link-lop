{
  "title": "API Service",
  "uid": "lop-api-service",
  "tags": ["lop", "api"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "external-api Requests (last hour)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "expr": "sum(count_over_time({source=\"edge-functions\", fn=\"external-api\"} | json | type=\"metric\" [1h]))",
          "legendFormat": "Requests"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "title": "external-api Errors (last hour)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "expr": "sum(count_over_time({source=\"edge-functions\", fn=\"external-api\"} | json | type=\"metric\" | error=\"true\" [1h]))",
          "legendFormat": "Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 3,
      "title": "external-api Avg Latency",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "expr": "avg(avg_over_time({source=\"edge-functions\", fn=\"external-api\"} | json | type=\"metric\" | unwrap duration_ms [5m]))",
          "legendFormat": "Avg ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 3000 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 4,
      "title": "Requests Over Time (by function)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "expr": "sum by (fn) (rate({source=\"edge-functions\"} | json | type=\"metric\" [$__rate_interval]) * 60)",
          "legendFormat": "{{fn}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" } }
    },
    {
      "id": 5,
      "title": "Status Code Distribution",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "expr": "sum by (status) (rate({source=\"edge-functions\", fn=\"external-api\"} | json | type=\"metric\" [$__rate_interval]) * 60)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" } }
    },
    {
      "id": 6,
      "title": "external-api Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "expr": "{source=\"edge-functions\", fn=\"external-api\"}", "legendFormat": "" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending" }
    }
  ]
}
