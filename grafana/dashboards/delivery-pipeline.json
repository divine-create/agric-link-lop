{
  "title": "Delivery Pipeline",
  "uid": "lop-delivery-pipeline",
  "tags": ["lop", "deliveries"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Deliveries Created (last hour)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "expr": "sum(count_over_time({source=\"edge-functions\", fn=\"deliveries\"} | json | type=\"metric\" | method=\"POST\" | status=201 [1h]))",
          "legendFormat": "Created"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "title": "Assignment SLA — avg (target < 5s)",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "expr": "avg(avg_over_time({source=\"edge-functions\", fn=\"decision-engine\"} | json | type=\"metric\" | unwrap duration_ms [5m])) / 1000",
          "legendFormat": "Avg (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 3,
      "title": "Decision Engine Errors (last hour)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "expr": "sum(count_over_time({source=\"edge-functions\", fn=\"decision-engine\"} | json | type=\"metric\" | error=\"true\" [1h]))",
          "legendFormat": "Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 4,
      "title": "Delivery Request Volume",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 8 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "expr": "sum(rate({source=\"edge-functions\", fn=\"deliveries\"} | json | type=\"metric\" [$__rate_interval]) * 600)",
          "legendFormat": "Requests per 10m"
        },
        {
          "expr": "sum(rate({source=\"edge-functions\", fn=\"deliveries\"} | json | type=\"metric\" | status=201 [$__rate_interval]) * 600)",
          "legendFormat": "Created per 10m"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "title": "Assignment Time Over Time",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "expr": "avg(avg_over_time({source=\"edge-functions\", fn=\"decision-engine\"} | json | type=\"metric\" | unwrap duration_ms [$__rate_interval])) / 1000",
          "legendFormat": "Avg assignment time (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 5 }]
          },
          "custom": { "thresholdsStyle": { "mode": "line+area" } }
        }
      }
    },
    {
      "id": 6,
      "title": "Delivery + Decision Engine Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "expr": "{source=\"edge-functions\", fn=~\"deliveries|decision-engine\"}", "legendFormat": "" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending" }
    }
  ]
}
